DJANGO_SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000

DJANGO_ENV=local

# Redis: backs the shared cache and (once externalized) SSE session/queue/stats
# state, enabling horizontal scaling across multiple gunicorn workers/replicas.
# Use rediss:// for TLS where the provider supports it. Defaults to a local
# instance for development.
REDIS_URL=redis://127.0.0.1:6379/0


NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Publive MCP
NEW_RELIC_USER_KEY=
SERVER_VERSION=1.0.0
